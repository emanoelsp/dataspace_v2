# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do dataspaceapp.
# Local: copie para .env.local e preencha. Vercel: cadastre em
# Project → Settings → Environment Variables (NÃO comitar segredos).
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (cliente / navegador) — vão para o bundle, não são segredos ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (servidor) — SEGREDO. Necessário p/ /api/m2m, /api/gateway, /api/sidecar/* ──
# Local: gere com  node scripts/set-service-account.mjs <arquivo.json>
# Vercel: cole o JSON da service account em UMA LINHA, SEM aspas em volta.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Sidecar ──
# Segredo compartilhado entre o Dataspace e os Sidecars (deve bater com o do PEP).
SIDECAR_ADMIN_SECRET=admin
# NÃO defina SIDECAR_URL em produção: o endpoint do sidecar vem no corpo de cada
# requisição M2M (cada CPS informa o seu). Um default localhost seria inútil na nuvem.

# ── Proteção opcional dos endpoints públicos ──
# Se definido, /api/m2m/register e /api/m2m/negotiate exigem o header X-M2M-Key.
# Recomendado em deploy público (dê a chave ao Marcos).
M2M_API_KEY=
# Se definido, /api/gateway/catalog exige o header X-Gateway-Key.
GATEWAY_API_KEY=
